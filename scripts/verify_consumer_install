#!/usr/bin/env bash
set -euo pipefail

version=${1:?usage: scripts/verify_consumer_install VERSION}
project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
consumer_dir=$(mktemp -d "${TMPDIR:-/tmp}/bufferutils-consumer.XXXXXX")

cleanup() {
  rm -rf "$consumer_dir"
}
trap cleanup EXIT

cp -R "$project_root/.github/consumer-smoke/." "$consumer_dir/"
sed "s/__BUFFERUTILS_VERSION__/$version/g" \
  "$consumer_dir/moon.mod.template" > "$consumer_dir/moon.mod"
rm "$consumer_dir/moon.mod.template"

cd "$consumer_dir"
moon update
moon check --target native --deny-warn
moon test --target native --deny-warn
moon run app --target native --release

echo "clean consumer verification passed for ZSeanYves/bufferutils@$version"
