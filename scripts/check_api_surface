#!/usr/bin/env bash
set -euo pipefail

allowlist=docs/API_ALLOWLIST.txt
candidate=$(mktemp)
normalized=$(mktemp)
diff_file=.tmp/API_SURFACE_DIFF.md
trap 'rm -f "$candidate" "$normalized"' EXIT

test -f "$allowlist"
mkdir -p .tmp
scripts/generate_api_allowlist "$candidate"
tr -d '\r' < "$allowlist" > "$normalized"

{
  printf '# Public API surface diff\n\n'
  printf 'Generated by `scripts/check_api_surface`. '
  printf 'An empty diff means the reviewed allowlist matches the generated interfaces.\n\n'
  printf '```diff\n'
  diff -u --label docs/API_ALLOWLIST.txt --label generated-api \
    "$normalized" "$candidate" || true
  printf '```\n'
} > "$diff_file"

if ! cmp -s "$normalized" "$candidate"; then
  cat "$diff_file" >&2
  printf '\nUnreviewed public API change detected.\n' >&2
  printf 'Review %s, record the decision, then regenerate the allowlist.\n' \
    "$diff_file" >&2
  exit 1
fi

scripts/check_api_names "$candidate"
scripts/check_api_evidence "$candidate"
printf 'public API matches the reviewed allowlist; diff report: %s\n' "$diff_file"
