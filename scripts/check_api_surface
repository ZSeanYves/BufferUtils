#!/usr/bin/env bash
set -euo pipefail

source_root=src

allowlist=docs/API_ALLOWLIST.txt
test -f "$allowlist"
generated_allowlist=$(mktemp)
trap 'rm -f "$generated_allowlist"' EXIT
scripts/generate_api_allowlist "$generated_allowlist"
if ! diff -u "$allowlist" "$generated_allowlist"; then
  printf 'generated public API differs from docs/API_ALLOWLIST.txt\n' >&2
  exit 1
fi

for file in \
  "$source_root/buffer/pkg.generated.mbti" \
  "$source_root/io/pkg.generated.mbti" \
  "$source_root/native/pkg.generated.mbti" \
  "$source_root/async_io/pkg.generated.mbti"; do
  test -f "$file"
done

required=(
  "buffer/pkg.generated.mbti|pub struct SharedBytes"
  "buffer/pkg.generated.mbti|pub struct SharedBytesSplit"
  "buffer/pkg.generated.mbti|pub struct BytesCursor"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::clone"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::as_bytes_view"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::from_fixed_array"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::unsafe_adopt_fixed_array"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::split_at"
  "buffer/pkg.generated.mbti|pub struct BytesMut"
  "buffer/pkg.generated.mbti|pub fn BytesMut::zeroed"
  "buffer/pkg.generated.mbti|pub fn BytesMut::put_bytes_view"
  "buffer/pkg.generated.mbti|pub struct BufChain"
  "buffer/pkg.generated.mbti|pub struct BufTake"
  "buffer/pkg.generated.mbti|pub(open) trait Buf"
  "buffer/pkg.generated.mbti|pub(open) trait BufMut"
  "io/pkg.generated.mbti|pub(open) trait Read"
  "io/pkg.generated.mbti|pub(open) trait Write"
  "io/pkg.generated.mbti|pub struct IoSlice"
  "io/pkg.generated.mbti|pub struct IoSliceMut"
  "io/pkg.generated.mbti|pub(open) trait BufRead"
  "io/pkg.generated.mbti|pub(open) trait Seek"
  "io/pkg.generated.mbti|pub(open) trait Close"
  "io/pkg.generated.mbti|pub fn IoError::message"
  "io/pkg.generated.mbti|pub fn[R] BufReader::new"
  "io/pkg.generated.mbti|pub fn[W] BufWriter::new"
  "io/pkg.generated.mbti|pub struct Lines"
  "io/pkg.generated.mbti|pub struct Split"
  "io/pkg.generated.mbti|pub struct BufReaderAdapter"
  "io/pkg.generated.mbti|pub struct BufMutWriterAdapter"
  "io/pkg.generated.mbti|pub struct Cursor"
  "io/pkg.generated.mbti|pub struct Empty"
  "io/pkg.generated.mbti|pub struct Repeat"
  "io/pkg.generated.mbti|pub struct Take"
  "io/pkg.generated.mbti|pub struct Chain"
  "io/pkg.generated.mbti|pub struct LineWriter"
  "io/pkg.generated.mbti|pub struct BufStream"
  "native/pkg.generated.mbti|pub struct NativeFile"
  "native/pkg.generated.mbti|pub struct NativeOpenOptions"
  "native/pkg.generated.mbti|pub struct NativeTcpStream"
  "native/pkg.generated.mbti|pub struct NativeTcpListener"
  "native/pkg.generated.mbti|pub struct MappedBytes"
  "native/pkg.generated.mbti|pub fn NativeFile::sync_all"
  "native/pkg.generated.mbti|pub fn NativeTcpStream::shutdown_both"
  "native/pkg.generated.mbti|pub(all) struct SocketAddress"
  "native/pkg.generated.mbti|pub fn NativeTcpStream::local_addr"
  "native/pkg.generated.mbti|pub fn NativeTcpStream::read_timeout_ms"
  "async_io/pkg.generated.mbti|pub(open) trait AsyncRead"
  "async_io/pkg.generated.mbti|pub(open) trait AsyncWrite"
  "async_io/pkg.generated.mbti|pub(open) trait AsyncBufRead"
  "async_io/pkg.generated.mbti|pub(open) trait AsyncSeek"
  "async_io/pkg.generated.mbti|pub(open) trait AsyncClose"
  "async_io/pkg.generated.mbti|pub struct AsyncBufReader"
  "async_io/pkg.generated.mbti|pub struct AsyncBufWriter"
  "async_io/pkg.generated.mbti|pub fn[W] AsyncBufWriter::buffered_len"
  "async_io/pkg.generated.mbti|pub struct AsyncLines"
  "async_io/pkg.generated.mbti|pub struct AsyncSplit"
  "async_io/pkg.generated.mbti|pub struct AsyncChain"
  "async_io/pkg.generated.mbti|pub struct AsyncTake"
  "async_io/pkg.generated.mbti|pub struct AsyncBufStream"
  "async_io/pkg.generated.mbti|pub struct AsyncDuplexStream"
  "async_io/pkg.generated.mbti|pub fn AsyncMemoryWriter::to_bytes"
  "async_io/pkg.generated.mbti|pub impl[R : AsyncSeek] AsyncSeek for AsyncBufReader[R]"
  "async_io/pkg.generated.mbti|pub impl[W : AsyncWrite + AsyncSeek] AsyncSeek for AsyncBufWriter[W]"
  "async_io/pkg.generated.mbti|pub async fn[R : AsyncRead, W : AsyncWrite] copy"
  "async_io/pkg.generated.mbti|pub async fn[A : AsyncRead + AsyncWrite, B : AsyncRead + AsyncWrite] copy_bidirectional"
  "async_io/pkg.generated.mbti|pub async fn[A : AsyncRead + AsyncWrite, B : AsyncRead + AsyncWrite] copy_bidirectional_with_sizes"
)

for requirement in "${required[@]}"; do
  file=${requirement%%|*}
  symbol=${requirement#*|}
  case "$file" in
    buffer/*|io/*|async_io/*|native/*|examples/*) file="$source_root/$file" ;;
  esac
  if ! grep -Fq "$symbol" "$file"; then
    printf 'missing public symbol: %s\n' "$symbol" >&2
    exit 1
  fi
done

forbidden=(
  "buffer/pkg.generated.mbti|pub fn SharedBytes::advance"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::clear"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::copy_to"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::get_u8"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::remaining"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::split_off"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::split_to"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::truncate"
  "buffer/pkg.generated.mbti|pub fn SharedBytes::copied_bytes"
  "buffer/pkg.generated.mbti|pub fn BytesMut::copied_bytes"
  "buffer/pkg.generated.mbti|pub impl Buf for SharedBytes"
  "io/pkg.generated.mbti|MemoryPipeState"
  "io/pkg.generated.mbti|pub struct MemoryPipe"
  "io/pkg.generated.mbti|pub struct MemoryPipeReader"
  "io/pkg.generated.mbti|pub struct MemoryPipeWriter"
  "async_io/pkg.generated.mbti|AsyncBufWriter::pending_len"
  "async_io/pkg.generated.mbti|AsyncMemoryWriter::bytes"
  "async_io/pkg.generated.mbti|bytes : Int"
)

for entry in "${forbidden[@]}"; do
  file=${entry%%|*}
  symbol=${entry#*|}
  case "$file" in
    buffer/*|io/*|async_io/*|native/*|examples/*) file="$source_root/$file" ;;
  esac
  if grep -Fq "$symbol" "$file"; then
    printf 'obsolete public symbol remains: %s\n' "$symbol" >&2
    exit 1
  fi
done

if [[ -f pkg.generated.mbti ]] && grep -Eq 'pub (struct|fn|type) (BufferReader|BufferWriter|MemorySource|MemorySink|FileSource|FileSink)' pkg.generated.mbti; then
  printf 'legacy root API is still public\n' >&2
  exit 1
fi

legacy_sources=(
  reader.mbt
  writer.mbt
  source.mbt
  sink.mbt
  buf_reader.mbt
  buf_writer.mbt
  native/bufferutils_native.c
)
for file in "${legacy_sources[@]}"; do
  if [[ -e "$file" ]]; then
    printf 'legacy implementation still exists: %s\n' "$file" >&2
    exit 1
  fi
done

printf 'public API surface checks passed for all package contracts\n'
