#!/usr/bin/env bash
set -euo pipefail

baseline=${1:?usage: check_performance_batches BASELINE.csv MOONBIT.csv RUST.csv}
moonbit_csv=${2:?missing MoonBit CSV}
rust_csv=${3:?missing Rust CSV}

for file in "$baseline" "$moonbit_csv" "$rust_csv"; do
  [[ -f "$file" ]] || {
    printf 'benchmark CSV not found: %s\n' "$file" >&2
    exit 1
  }
done

awk -F, -v baseline_file="$baseline" '
function fail(message) {
  print message > "/dev/stderr"
  failed = 1
}
FILENAME == baseline_file {
  if (FNR == 1) {
    if ($1 != "name" || $2 != "size" || $3 != "moonbit_over_rust") {
      fail("invalid ratio baseline header")
    }
    next
  }
  key = $1 SUBSEP $2
  baseline[key] = $3 + 0
  next
}
FILENAME != baseline_file {
  if (FNR == 1) { next }
  implementation = $1
  key = $2 SUBSEP $3
  batch = $4 + 0
  per_iteration = ($6 + 0) / ($5 + 0)
  timing[implementation, key, batch] = per_iteration
  next
}
END {
  for (key in baseline) {
    for (batch = 1; batch <= 3; batch++) {
      moon_key = "moonbit" SUBSEP key SUBSEP batch
      rust_key = "rust" SUBSEP key SUBSEP batch
      if (!(moon_key in timing) || !(rust_key in timing)) {
        fail("missing comparison row: " key " batch " batch)
        continue
      }
      ratio = timing[moon_key] / timing[rust_key]
      if (ratio > baseline[key] * 1.15) regressions[key]++
    }
  }
  for (key in regressions) {
    if (regressions[key] >= 2) {
      fail("MoonBit/Rust ratio regressed by more than 15% in at least two batches: " key)
    }
  }
  if (!failed) print "per-case MoonBit/Rust ratio gate passed"
  exit failed
}
' "$baseline" "$moonbit_csv" "$rust_csv"
