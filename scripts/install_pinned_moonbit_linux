#!/usr/bin/env bash
set -euo pipefail

destination=${1:?usage: install_pinned_moonbit_linux DESTINATION}
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) ;;
  *)
    printf 'pinned MoonBit archive only supports Linux x86_64\n' >&2
    exit 1
    ;;
esac

[[ ! -e "$destination" ]] || {
  printf 'MoonBit destination already exists: %s\n' "$destination" >&2
  exit 1
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
# shellcheck disable=SC1091
source "$repo_root/toolchains/moonbit-linux-x86_64.lock"

download_dir=$(mktemp -d "${TMPDIR:-/tmp}/bufferutils-moonbit.XXXXXX")
trap 'rm -rf "$download_dir"' EXIT
toolchain_archive="$download_dir/moonbit.tar.gz"
core_archive="$download_dir/core.tar.gz"

curl -fsSL --retry 3 -o "$toolchain_archive" \
  "https://cli.moonbitlang.com/binaries/$MOONBIT_CHANNEL/moonbit-linux-x86_64-dev.tar.gz"
curl -fsSL --retry 3 -o "$core_archive" \
  "https://cli.moonbitlang.com/cores/core-$MOONBIT_CHANNEL.tar.gz"

printf '%s  %s\n' "$MOONBIT_ARCHIVE_SHA256" "$toolchain_archive" | sha256sum --check --status
printf '%s  %s\n' "$MOONBIT_CORE_SHA256" "$core_archive" | sha256sum --check --status

mkdir -p "$destination/lib"
tar xf "$toolchain_archive" --directory="$destination"
tar xf "$core_archive" --directory="$destination/lib"
chmod +x "$destination/bin/"*
"$destination/bin/moon" -C "$destination/lib/core" bundle --warn-list -a --all
"$destination/bin/moon" -C "$destination/lib/core" bundle --warn-list -a --target wasm-gc --quiet

version_output=$("$destination/bin/moon" version --all)
printf '%s\n' "$version_output"
grep -Fq "moon $MOONBIT_VERSION ($MOONBIT_COMMIT" <<< "$version_output"
grep -Fq "moonc $MOONC_VERSION" <<< "$version_output"
