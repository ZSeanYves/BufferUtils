#!/usr/bin/env bash
set -euo pipefail

output=${1:?usage: build_performance_baseline OUTPUT.csv MOONBIT.csv RUST.csv}
moonbit_csv=${2:?missing MoonBit CSV}
rust_csv=${3:?missing Rust CSV}

for file in "$moonbit_csv" "$rust_csv"; do
  [[ -f "$file" ]] || {
    printf 'benchmark CSV not found: %s\n' "$file" >&2
    exit 1
  }
done

awk -F, '
FNR == 1 { next }
{
  implementation = $1
  if ($2 ~ /^native_/ || $2 ~ /^tcp_loopback/) next
  key = $2 SUBSEP $3
  batch = $4 + 0
  timing[implementation, key, batch] = ($6 + 0) / ($5 + 0)
  name[key] = $2
  size[key] = $3
}
END {
  print "name,size,moonbit_over_rust"
  for (key in name) {
    count = 0
    for (batch = 1; batch <= 3; batch++) {
      moon_key = "moonbit" SUBSEP key SUBSEP batch
      rust_key = "rust" SUBSEP key SUBSEP batch
      if ((moon_key in timing) && (rust_key in timing)) {
        values[++count] = timing[moon_key] / timing[rust_key]
      }
    }
    if (count != 3) continue
    a = values[1]; b = values[2]; c = values[3]
    if (a > b) { t = a; a = b; b = t }
    if (b > c) { t = b; b = c; c = t }
    if (a > b) { t = a; a = b; b = t }
    print name[key] "," size[key] "," b
    delete values
  }
}
' "$moonbit_csv" "$rust_csv" | {
  IFS= read -r header
  printf '%s\n' "$header"
  sort -t, -k1,1 -k2,2n
} > "$output"
