#!/usr/bin/env bash
set -euo pipefail

run_contract() {
  local label="$1"
  shift
  local output
  output=$("$@" 2>&1)
  printf '%s\n' "$output"
  if ! printf '%s\n' "$output" | grep -Eq 'Total tests: [1-9][0-9]*,'; then
    printf 'critical contract filter matched no tests: %s\n' "$label" >&2
    return 1
  fi
}

run_contract vectored-fallback \
  moon test io/io_test.mbt --target native --deny-warn --frozen --filter '*vectored*'
run_contract buffered-writer-recovery \
  moon test io/io_test.mbt --target native --deny-warn --frozen \
  --filter '*BufWriter preserves*'
run_contract async-error-mapping \
  moon test async_io/errors_wbtest.mbt --target native --deny-warn --frozen
run_contract async-cancellation \
  moon test async_io --target native --deny-warn --frozen --filter '*cancellation*'
run_contract native-error-mapping \
  moon test native/native_wbtest.mbt --target native --deny-warn --frozen \
  --filter '*error classification*'
run_contract native-close-race \
  moon test native/native_wbtest.mbt --target native --deny-warn --frozen \
  --filter '*race*close*'

printf 'critical error mapping, cancellation, vectored fallback, recovery, and close-race contracts passed\n'
