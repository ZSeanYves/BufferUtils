#!/usr/bin/env bash
set -euo pipefail

moonbit_only=0
if [[ ${1:-} == "--moonbit-only" ]]; then
  moonbit_only=1
  shift
fi
output_dir=${1:?usage: scripts/merge_performance_batches [--moonbit-only] OUTPUT_DIR}

prefixes=(moonbit moonbit-async)
if ((moonbit_only == 0)); then
  prefixes+=(rust)
fi
for prefix in "${prefixes[@]}"; do
  for batch in 1 2 3; do
    file="$output_dir/$prefix-batch-$batch.csv"
    [[ -f "$file" ]] || {
      echo "missing benchmark batch: $file" >&2
      exit 1
    }
    for kind in raw copy-evidence; do
      auxiliary="$output_dir/$prefix-$kind-batch-$batch.csv"
      [[ -f "$auxiliary" ]] || {
        echo "missing benchmark evidence: $auxiliary" >&2
        exit 1
      }
    done
  done
done

head -n 1 "$output_dir/moonbit-batch-1.csv" > "$output_dir/moonbit.csv"
for batch in 1 2 3; do
  tail -n +2 "$output_dir/moonbit-batch-$batch.csv" >> "$output_dir/moonbit.csv"
done
for batch in 1 2 3; do
  tail -n +2 "$output_dir/moonbit-async-batch-$batch.csv" \
    >> "$output_dir/moonbit.csv"
done

head -n 1 "$output_dir/moonbit-async-batch-1.csv" \
  > "$output_dir/moonbit-async.csv"
for batch in 1 2 3; do
  tail -n +2 "$output_dir/moonbit-async-batch-$batch.csv" \
    >> "$output_dir/moonbit-async.csv"
done

if ((moonbit_only == 0)); then
  head -n 1 "$output_dir/rust-batch-1.csv" > "$output_dir/rust.csv"
  for batch in 1 2 3; do
    tail -n +2 "$output_dir/rust-batch-$batch.csv" >> "$output_dir/rust.csv"
  done
fi

for kind in raw copy-evidence; do
  head -n 1 "$output_dir/moonbit-$kind-batch-1.csv" \
    > "$output_dir/moonbit-$kind.csv"
  for batch in 1 2 3; do
    tail -n +2 "$output_dir/moonbit-$kind-batch-$batch.csv" \
      >> "$output_dir/moonbit-$kind.csv"
    tail -n +2 "$output_dir/moonbit-async-$kind-batch-$batch.csv" \
      >> "$output_dir/moonbit-$kind.csv"
  done

  if ((moonbit_only == 0)); then
    head -n 1 "$output_dir/rust-$kind-batch-1.csv" \
      > "$output_dir/rust-$kind.csv"
    for batch in 1 2 3; do
      tail -n +2 "$output_dir/rust-$kind-batch-$batch.csv" \
        >> "$output_dir/rust-$kind.csv"
    done
  fi
done
